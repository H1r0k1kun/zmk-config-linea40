#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <scroll-snap.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <mouse-gesture.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 3
#define SCROLL 4
#define FUNCTION 6
#define WIRELESS 7

/* スクロールスナップ設定 */

&zip_scroll_snap {
    x-threshold = <5 8>;
    y-threshold = <8 5>;
    xy-threshold = <5 8>;
    require-n-samples = <10>;
    immediate-snap-threshold = <1500>;
    lock-duration-ms = <200>;
    lock-for-next-n-events = <10>;
    idle-reset-timeout-ms = <200>;
};

/* マウスジェスチャー */

&zip_mouse_gesture {
    stroke-size = <150>;
    enable-eager-mode;

    history_back {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LA(LEFT)>;
    };

    history_forward {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LA(RIGHT)>;
    };

    close_tab {
        pattern = <GESTURE_DOWN GESTURE_RIGHT>;
        bindings = <&kp LA(F4)>;
    };

    new_tab {
        pattern = <GESTURE_DOWN GESTURE_LEFT>;
        bindings = <&kp LC(T)>;
    };

    app_switcher {
        pattern = <GESTURE_DOWN GESTURE_UP>;
        bindings = <&kp LG(TAB)>;
    };

    virtual_desktop_prev {
        pattern = <GESTURE_LEFT GESTURE_DOWN>;
        bindings = <&kp LG(LC(LEFT))>;
    };

    virtual_desktop_next {
        pattern = <GESTURE_RIGHT GESTURE_DOWN>;
        bindings = <&kp LG(LC(RIGHT))>;
    };
};

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 1 3>; //スクロールを3倍速にする
    };
};

// ---------------------------------------------------------------------------
// ズームボタン（2026-10-06 追加）
//
// 1回押すと1段階だけズームする。配置は ZMK Studio で各自行う
// （下の display-name が Studio の一覧に出る名前）。
//
// ■ Windows: 「Ctrl を押しながらホイールを1ノッチ」を出す
//   キーボードショートカット（Ctrl + = 等）は使わない。
//   - JIS 配列の OS では HID の EQUAL が「^」として届き、Ctrl + ^ になる
//   - テンキーの + / - は Excel でセルの挿入・削除になる
//   - Word には既定のズームショートカットが無い
//   Ctrl + ホイールなら、ブラウザ・Excel・Word・エクスプローラーすべてで
//   アプリ自身の最小単位で1段階ズームする。
//
// ■ Mac: ⌘ + テンキーの + / -
//   Mac の Ctrl + ホイールは画面全体の拡大（アクセシビリティ）でアプリのズームではない。
//   テンキーの + / - は JIS / US の配列に関係なく「+」「-」の文字になるため、
//   アプリの「⌘+」「⌘-」に一致する。
//   予備として ⌘ + Shift + ;（JIS 配列で「+」を出す組み合わせ）も用意した。
//   実機でどちらが効くか確認できたら、効かなかった方は消す。
//
// ■ C_AC_ZOOM_IN / C_AC_ZOOM_OUT（HID の「ズーム」キー）は使わない
//   ZMK のキーコード表（docs/src/data/hid.js:7407-7465）で動作確認済みなのは
//   Linux のみ。Windows / macOS / iOS は未確認、Android は非対応。
//   以前これを置いて反応しなかったのはこのため。
// ---------------------------------------------------------------------------

/ {
    behaviors {
        // ズーム専用のホイール。既存の &msc とは別にする。
        // &msc には独自の速度設定と、Function レイヤーで3倍にする倍率がかかっているため、
        // それを通すと1回あたりの量が決まらない。
        //
        // 1ノッチちょうどにする仕組み（behavior_input_two_axis.c:111-153 / 175-230）:
        //   押した瞬間には何も出さず、trigger-period-ms 後に初めて
        //   「速度 × trigger-period-ms / 1000」だけ出す。加速（acceleration-exponent）は 0。
        //   速度 10 × 100ms / 1000 = 1.0 ＝ ホイール値 1。
        //   次は 200ms 後なので、その前（150ms）に離せば1回だけで止まる。
        // ホイール値 1 ＝ Windows の1ノッチ（ZMK_POINTING_SMOOTH_SCROLLING が無効のため
        // 解像度倍率が無く、1 がそのまま1ノッチとして扱われる）。
        zoom_wheel: zoom_wheel {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            // Studio の一覧にも出るが、直接キーに置くと Ctrl なしの単発スクロールになる。置かないこと。
            display-name = "(internal - do not assign) Zoom wheel";
            x-input-code = <INPUT_REL_HWHEEL>;
            y-input-code = <INPUT_REL_WHEEL>;
            trigger-period-ms = <100>;
            time-to-max-speed-ms = <0>;
            acceleration-exponent = <0>;
        };

        // macro_wait_time は「それ以降の各ステップの後に入る待ち時間」を変える
        // （behavior_macro.c:22-30）。マクロは1本の順番待ちに積まれるので、
        // 連打しても前の1回が終わってから次が動き、Ctrl やホイールが重ならない。
        //
        // 各ステップの後に入る待ち:
        //   Ctrl 押下 → 30ms → ホイール押下 → 150ms（＝ホイールを押し続ける時間）→
        //   ホイール解放 → 30ms → Ctrl 解放
        // ホイールの値は押してから 100ms 後に1回だけ出るので、Ctrl の約130ms後に届く。
        // キーボードとマウスの送信は別々の待ち列（hog.c:288 / hog.c:394）なので、
        // この間隔で「Ctrl が先に届く」順番を守る。
        zoom_in_win: zoom_in_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Zoom In (Win)";
            bindings
                = <&macro_wait_time 30>
                , <&macro_press &kp LCTRL>
                , <&macro_wait_time 150>
                , <&macro_press &zoom_wheel MOVE_Y(10)>
                , <&macro_wait_time 30>
                , <&macro_release &zoom_wheel MOVE_Y(10)>
                , <&macro_release &kp LCTRL>
                ;
        };

        zoom_out_win: zoom_out_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Zoom Out (Win)";
            bindings
                = <&macro_wait_time 30>
                , <&macro_press &kp LCTRL>
                , <&macro_wait_time 150>
                , <&macro_press &zoom_wheel MOVE_Y(-10)>
                , <&macro_wait_time 30>
                , <&macro_release &zoom_wheel MOVE_Y(-10)>
                , <&macro_release &kp LCTRL>
                ;
        };

        zoom_in_mac: zoom_in_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Zoom In (Mac)";
            bindings = <&macro_tap &kp LG(KP_PLUS)>;
        };

        zoom_out_mac: zoom_out_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Zoom Out (Mac)";
            bindings = <&macro_tap &kp LG(KP_MINUS)>;
        };

        // 予備: ⌘ + Shift + ;
        // JIS 配列では「+」は Shift + ; で出る。⌘ + ; だけだと「⌘;」になり ⌘+ に一致しない。
        zoom_in_mac_alt: zoom_in_mac_alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Zoom In (Mac alt)";
            bindings = <&macro_tap &kp LG(LS(SEMI))>;
        };
    };

    zoom_wheel_input_listener: zoom_wheel_input_listener {
        compatible = "zmk,input-listener";
        device = <&zoom_wheel>;
    };
};

&mouse_gesture_kp {
    tapping-term-ms = <200>;
    quick-tap-ms = <250>;
    flavor = "balanced";
};

&mouse_gesture_mkp {
    tapping-term-ms = <200>;
    quick-tap-ms = <250>;
    flavor = "balanced";
};

/ {
    battery_type: battery_type {
        compatible = "zmk,behavior-battery-type";
        #binding-cells = <0>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        mb1 {
            bindings = <&mkp MB1>;
            key-positions = <16 17>;
            timeout-ms = <100>;
            layers = <0 1 2>;
        };

        mb2 {
            bindings = <&mkp MB2>;
            key-positions = <17 18>;
            timeout-ms = <100>;
            layers = <0 1 2>;
        };

        app_switch {
            bindings = <&kp F3>;
            key-positions = <18 19>;
            timeout-ms = <100>;
            layers = <0>;
        };

        muhenkan {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <35 10>;
        };

        globe {
            bindings = <&kp F15>;
            key-positions = <18 17 16>;
            layers = <0>;
        };

        mac_sc {
            bindings = <&kp LG(LS(NUMBER_4))>;
            key-positions = <6 7>;
            layers = <0>;
        };

        mac_capture {
            bindings = <&kp LG(LS(NUMBER_4))>;
            key-positions = <32 11 33>;
            layers = <0>;
        };

        ast {
            bindings = <&noteplan_task>;
            key-positions = <26 27>;
            layers = <0>;
        };

        taskcomp {
            bindings = <&noteplan_taskcomp>;
            key-positions = <37 16 17>;
            layers = <0>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        td_mhenkan: tap_dance_mhenkan {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MHENKAN";
            #binding-cells = <0>;

            // ダブルタップ判定時間（お好みで）

            tapping-term-ms = <220>;

            // 1タップ → 無変換, 2タップ → 変換

            bindings = <
                &kp INT_MUHENKAN
                &kp INT_HENKAN
            >;
        };

        /* ここから追加：ホールドでレイヤー + タップで上のタップダンス */

        lt_mhenkan: layer_tap_mhenkan {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_MHENKAN";

            // ※ hold-tap は #binding-cells = <2> 固定

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;

            // hold側: &mo (レイヤー一時有効)
            // tap側: さっきの tap-dance

            bindings = <&mo>, <&td_mhenkan>;
        };

        /*
         * Windows レイヤーの Z 用 mod-tap。
         * 標準の &mt は flavor = "hold-preferred" のため、
         * 「他のキーが押された瞬間、経過時間に関係なく Shift 確定」してしまい、
         * 「ざ・ず・ぞ」など Z の直後に母音を高速で打つと Shift+母音 に化けていた。
         *
         * tap-preferred は「経過時間だけ」で hold/tap を決めるので、
         * 何を続けて押しても tapping-term-ms を超えるまでは必ず Z になる。
         *
         * Shift が出しにくい / 出やすすぎると感じたら tapping-term-ms だけ調整する。
         */

        z_shift: z_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "Z_SHIFT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;

            // 1回目の押下から 200ms 以内に同じキーを押し直したら必ず Z（zz の連打対策）
            // ※ 基準は「離してから」ではなく「最初に押してから」

            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        alt8_ht: alt8_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "ALT8_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;

            // hold 側: Alt+Layer8 マクロ
            // tap 側: 通常の &kp

            bindings = <&alt_layer8>, <&kp>;
        };
    };

    macros {
        bt0_mac: bt0_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1 &tog_off 2>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT0_MAC";
        };

        bt1_ipad: bt1_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1 &tog_off 2>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 1>;

            label = "BT1_IPAD";
        };

        bt2_ipad: bt2_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1 &tog_off 2>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 2>,
                <&macro_wait_time 500>,
                <&tog_on 1>;

            label = "BT2_IPAD";
        };

        bt3_msol: bt3_msoll_ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1 &tog_off 2>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 3>,
                <&macro_wait_time 500>,
                <&tog_on 2>;

            label = "BT3_MSOLL_";
        };

        bt4_kd: bt4_kd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1 &tog_off 2>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 4>,
                <&macro_wait_time 500>,
                <&tog_on 2>;

            label = "BT4_KD";
        };

        all_disc: all_disc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4>;
            label = "ALL_DISC";
        };

        alt_layer8: alt_layer8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;

            // 押したときに layer8 + LEFT_ALT を押し、
            // 離したときに両方離す

            bindings =
                <&macro_press>,
                <&mo 8 &kp LEFT_ALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 8 &kp LEFT_ALT>;
        };

        noteplan_task: noteplan_task {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(APOS) &kp SPACE>;
            label = "NOTEPLAN_TASK";
        };

        noteplan_taskcomp: noteplan_taskcomp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&mkp MB1>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "NOTEPLAN_TASKCOMP";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Mac {
            bindings = <
&kp Q         &kp W         &kp E             &kp R                        &kp T                                           &kp Y        &kp U  &kp I      &kp O     &kp P
&kp A         &kp S         &kp D             &kp F                        &kp G                                           &kp H        &kp J  &lt 4 K    &kp L     &lt 8 MINUS
&kp Z         &kp X         &kp C             &kp V                        &kp B                                           &kp N        &kp M  &kp COMMA  &kp DOT   &kp SLASH
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &mt LEFT_SHIFT INT_MUHENKAN  &lt 3 SPACE  &lt 4 INT_HENKAN    &kp BACKSPACE  &lt 5 ENTER         &mkp MB4   &mkp MB5  &lt 7 LS(F12)
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        iPad {
            bindings = <
&kp Q         &kp W         &kp E             &kp R                      &kp T                                           &kp Y        &kp U  &kp I      &kp O     &kp P
&kp A         &kp S         &kp D             &kp F                      &kp G                                           &kp H        &kp J  &lt 4 K    &kp L     &lt 8 MINUS
&kp Z         &kp X         &kp C             &kp V                      &kp B                                           &kp N        &kp M  &kp COMMA  &kp DOT   &kp SLASH
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &mt LEFT_SHIFT LANGUAGE_2  &lt 3 SPACE  &lt 4 LANGUAGE_1    &kp BACKSPACE  &lt 5 ENTER         &mkp MB4   &mkp MB5  &lt 7 LS(SLASH)
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        Windows {
            bindings = <
&kp Q                  &kp W                &kp E         &kp R                        &kp T                                           &kp Y        &kp U                  &kp I      &kp O     &kp P
&lt 4 A                &kp S                &kp D         &kp F                        &kp G                                           &kp H        &mouse_gesture_kp 0 J  &lt 4 K    &kp L     &lt 6 MINUS
&z_shift LEFT_SHIFT Z  &kp X                &kp C         &kp V                        &kp B                                           &kp N        &kp M                  &kp COMMA  &kp DOT   &kp SLASH
&kp LEFT_CONTROL       &alt8_ht 0 LEFT_ALT  &kp LEFT_GUI  &mt LEFT_SHIFT INT_MUHENKAN  &lt 3 SPACE  &lt 4 INT_HENKAN    &kp BACKSPACE  &lt 5 ENTER                         &mkp MB4   &mkp MB5  &lt 7 LS(SLASH)
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        Mouse {
            bindings = <
&kp ESCAPE      &kp F2           &trans            &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)                    &trans    &kp BACKSPACE   &kp DELETE      &trans           &trans
&kp TAB         &kp PERCENT      &kp LEFT_BRACKET  &kp RIGHT_BRACKET   &kp LS(N8)                             &trans    &mkp MB1        &lt 4 UP_ARROW  &mkp MB2         &trans
&kp LEFT_SHIFT  &kp EXCLAMATION  &kp APOS          &kp BACKSLASH       &kp LS(N9)                             &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&trans          &trans           &kp SEMI          &trans              &kp TAB              &trans    &trans  &trans                    &kp LC(HOME)    &kp LC(END)      &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        Scroll {
            bindings = <
&trans  &trans  &trans  &trans              &trans                                           &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans              &trans                                           &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)                              &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans              &trans               &kp INT_MUHENKAN    &trans  &trans            &trans  &trans    &trans
            >;
        };

        Num {
            bindings = <
&kp MINUS          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS                         &trans                   &kp BACKSPACE   &kp DELETE    &trans           &trans
&kp NUMBER_0       &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp LS(SEMI)                     &kp LG(BACKSLASH)        &mkp MB1        &kp UP_ARROW  &mkp MB2         &trans
&mt LEFT_SHIFT N0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LS(MINUS)                    &kp LS(INTERNATIONAL_1)  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &trans
&trans             &trans        &kp PERIOD    &trans        &trans         &trans    &trans  &trans                                   &kp LC(LEFT)  &kp LC(RIGHT)    &trans
            >;
        };

        Function {
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F10                    &bt3_msol                &bt0_mac        &kp DELETE    &trans           &trans
&trans  &kp F4  &kp F5  &kp F6  &trans                     &bt4_kd                  &mkp MB1        &kp UP_ARROW  &bt1_ipad        &trans
&trans  &kp F1  &kp F2  &kp F3  &trans                     &kp LS(INTERNATIONAL_1)  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &trans  &trans   &trans    &trans  &trans                                   &zoom_in_win  &zoom_out_win  &battery_type
            >;
        };

        ZMK {
            bindings = <
&trans      &trans        &trans        &trans        &trans                         &bt0_mac        &bt1_ipad     &bt2_ipad     &bt3_msol     &bt4_kd
&kp N0      &kp NUMBER_4  &trans        &trans        &trans                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&bt BT_CLR  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans                         &trans          &trans        &trans        &trans        &all_disc
&trans      &trans        &trans        &trans        &trans  &trans    &bootloader  &studio_unlock                &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        iPad_tcc {
            bindings = <
&trans  &trans  &trans  &trans  &trans                            &bt3_msol  &bt0_mac  &kp I   &trans     &trans
&trans  &trans  &trans  &trans  &trans                            &bt4_kd    &kp S     &kp K   &bt2_ipad  &trans
